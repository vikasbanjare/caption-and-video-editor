# Transcription (Phase 2). With no key set, /api/transcribe uses the built-in
# stub (sample transcript) so the app works out of the box.

# Set this to enable real word-level transcription via Deepgram.
# Get a key at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Optional: override the Deepgram model (default: nova-2). e.g. nova-3
# DEEPGRAM_MODEL=nova-2
