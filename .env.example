# Transcription (Phase 2). With no key set, /api/transcribe uses the built-in
# stub (sample transcript) so the app works out of the box.

# Provider priority: Deepgram → AssemblyAI → stub. Set one of these keys.

# Deepgram (single synchronous request). https://console.deepgram.com/
DEEPGRAM_API_KEY=
# Optional: override the Deepgram model (default: nova-2). e.g. nova-3
# DEEPGRAM_MODEL=nova-2

# AssemblyAI (async: upload → poll). https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=
